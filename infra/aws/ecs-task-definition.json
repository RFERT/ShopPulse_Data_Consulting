{
  "family": "shoppulse-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/shoppulse-ecs-execution",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/shoppulse-api:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "POSTGRES_HOST", "value": "<RDS_ENDPOINT>" },
        { "name": "POSTGRES_PORT", "value": "5432" },
        { "name": "POSTGRES_DB", "value": "shoppulse" },
        { "name": "POSTGRES_USER", "value": "shoppulse" },
        { "name": "SHOPPULSE_MODELS_DIR", "value": "/app/artifacts/models" }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-west-3:<ACCOUNT_ID>:secret:shoppulse/db_password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shoppulse-api",
          "awslogs-region": "eu-west-3",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
