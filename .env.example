# --- Base de données PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shoppulse
POSTGRES_USER=shoppulse
POSTGRES_PASSWORD=shoppulse

# --- Airflow ---
AIRFLOW_UID=50000

# --- Ports hôte exposés par docker-compose ---
# À modifier uniquement si un port est déjà occupé sur votre machine.
# Seul le port HÔTE (à gauche du ":") change ; les ports internes aux conteneurs
# restent fixes. Exemple : API_PORT=8010 rend l'API sur http://localhost:8010.
POSTGRES_HOST_PORT=5432   # PostgreSQL (si vous changez ce port, alignez POSTGRES_PORT)
API_PORT=8000             # API FastAPI
DASHBOARD_PORT=8501       # Dashboard Streamlit
AIRFLOW_PORT=8080         # Interface Airflow
MLFLOW_PORT=5000          # MLflow (profil tracking)
ELASTICSEARCH_PORT=9200   # Elasticsearch (profil observability)
KIBANA_PORT=5601          # Kibana (profil observability)

